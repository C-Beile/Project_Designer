{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dito Designer (Debug, GNU)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/designer-app.exe",
            "args": [],
            "cwd": "${workspaceFolder}/app/src-tauri",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "debug: prepare",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
