<?xml version="1.0" encoding="UTF-8"?>
<preferences xmlns="http://www.adito.de/2018/ao/Model" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" VERSION="3.4.3" xsi:schemaLocation="http://www.adito.de/2018/ao/Model adito://models/xsd/preferences/3.4.3">
  <name>_____PREFERENCES_PROJECT</name>
  <majorModelMode>DISTRIBUTED</majorModelMode>
  <customized />
  <mailGlobalUserServerEnabled v="true" />
  <projectName>ADITO xRM</projectName>
  <jditoMaxContentSize v="57671680" />
  <mailEnableUserDefault v="true" />
  <mailDefaultMailserver>mailServerIMAP</mailDefaultMailserver>
  <mailRepositoryAlias>defaultDbRepository</mailRepositoryAlias>
  <calendarCategoriesEvent>
    <entry>
      <key>Meeting</key>
      <value></value>
    </entry>
    <entry>
      <key>Organisation</key>
      <value></value>
    </entry>
    <entry>
      <key>OutOfOffice</key>
      <value></value>
    </entry>
    <entry>
      <key>Vacation</key>
      <value></value>
    </entry>
  </calendarCategoriesEvent>
  <multilingualismIndexSearchLocales>
    <element>de</element>
    <element>en</element>
  </multilingualismIndexSearchLocales>
  <managerBackendAlias>ManagerBackend</managerBackendAlias>
  <messageQueueAlias>MessageQueue</messageQueueAlias>
  <pdfPreviewAlias>PdfPreview</pdfPreviewAlias>
  <contentAnalysisAlias>ContentAnalysis</contentAnalysisAlias>
  <textAnalysisAlias>TextAnalysis</textAnalysisAlias>
  <clientSearchExcludeForIgnorecase v="true" />
  <neonClientPermissionsEnabled v="true" />
  <hashtagsEnabled v="false" />
  <blobHandlingMethod>PROCESS</blobHandlingMethod>
  <databaseAuditProcessLoggerUser>Admin</databaseAuditProcessLoggerUser>
  <databaseAuditGetOldValueLobs v="false" />
  <indexsearchGlobalEnabled v="true" />
  <indexsearchFullIndexerEnabled v="true" />
  <indexsearchFullIndexerInterval v="0" />
  <indexsearchIncrementingIndexerEnabled v="true" />
  <indexsearchIncrementingIndexerInterval v="15000" />
  <indexsearchIncrementingIndexerBunchSize v="250" />
  <userdirectoryAlias>_____SYSTEMALIAS</userdirectoryAlias>
  <binariesAlias>_____SYSTEMALIAS</binariesAlias>
  <mailBridgeMailserver>
    <mailbridgeMailserver>
      <name>abfa63d1-a47e-41f6-a87d-138bf04adc1e</name>
      <enabled v="true" />
      <bridgeName>Activity_Mailbridge</bridgeName>
      <serverName>mailServerIMAP</serverName>
      <timeout v="20000" />
      <user>mailbridge</user>
      <intervall v="60000" />
      <bridgeMode v="1" />
      <flagMode v="2" />
      <process>mailbridge</process>
      <errorProcess></errorProcess>
      <attachmentHandling>ALL</attachmentHandling>
    </mailbridgeMailserver>
  </mailBridgeMailserver>
  <customConfigProperties>
    <customBooleanProperty>
      <name>dataCaching.client.forceDisable</name>
      <description>Enabling this option will disable the per-client-context data-cache within the customzing (for exameple the caching of Keywords). This is usefull if you're testing and want to frequently add data like keywords, etc. which are cached which help of the "DataCaching_lib".</description>
    </customBooleanProperty>
    <customStringProperty>
      <name>geo.maptiler.apikey</name>
      <description>An API Key for using Maptiler functions. For example for the MapViewTemplate.</description>
    </customStringProperty>
    <customIntegerProperty>
      <name>bulkmail.dateToSendPassedAfter</name>
      <description>Number of hours after which a planned Bulkmail no longer gets send</description>
      <property v="24" />
    </customIntegerProperty>
    <customStringProperty>
      <name>bulkmail.baseReplacementURL</name>
      <description>Base url for replacement of redirectlinks in bulkmails</description>
    </customStringProperty>
    <customStringProperty>
      <name>bulkmail.fileStorage</name>
      <description>Save Location for send Mails. When empty %aditodata% gets used.</description>
      <property>/opt/ADITO/binaryfiles</property>
    </customStringProperty>
    <customStringProperty>
      <name>bulkmail.user</name>
      <description>Title of the useraccount that is used to send bulkmails</description>
      <property>mailbridge</property>
    </customStringProperty>
    <customStringProperty>
      <name>bulkmail.bg.serverId</name>
      <description>ServerId of the background Server for sending bulkmails</description>
    </customStringProperty>
    <customStringProperty>
      <name>mosaico.url</name>
      <description>Url of the Mosaico Email Editor</description>
    </customStringProperty>
    <customBooleanProperty>
      <name>snapADDY.isEnabled</name>
      <description>Whether the webservice snapADDY, is useable or not. The default webservice is snapADDY, so if the property abbyy.ocr.isEnabled is also true the snapADDY webservice is used.</description>
    </customBooleanProperty>
    <customPasswordProperty>
      <name>snapADDY.apiKey</name>
      <description>The accessToken for the webservice snapADDY ocr.</description>
    </customPasswordProperty>
    <customBooleanProperty>
      <name>sign8.isEnabled</name>
      <description>Whether the webservice sign8 is useable or not. </description>
      <property v="true" />
    </customBooleanProperty>
    <customPasswordProperty>
      <name>sign8.apiKey</name>
      <description>Api Key for sign8</description>
      <property>eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..xXICNuLng5CZagE3X3I2Z_ZoZ9JzKr9o2fp158Fxb5I</property>
    </customPasswordProperty>
    <customStringProperty>
      <name>sign8.token_Id</name>
      <description>token for sign8</description>
      <property>b8c027fc-8d5d-4a71-b5b4-9be53ae56802</property>
    </customStringProperty>
    <customStringProperty>
      <name>sign8.interface_id</name>
      <description>interface_id for sign8</description>
      <property>806ceaa1-97f1-4f88-a808-42630417061d</property>
    </customStringProperty>
    <customStringProperty>
      <name>sign8.license_key</name>
      <description>license_key for sign8</description>
      <property>20886362-2ab6-4613-900a-e8820a5ce614</property>
    </customStringProperty>
    <customStringProperty>
      <name>sign8.organization_id</name>
      <description>org id for sign8</description>
      <property>95b5a49a-f44e-4031-9cb2-910536276d17</property>
    </customStringProperty>
    <customStringProperty>
      <name>sign8.systemApiUrl</name>
      <description>url of the sign8 api (e.g: https://dev-api.sign8.eu/api)</description>
      <property>https://signing.sign8.eu/api</property>
    </customStringProperty>
    <customStringProperty>
      <name>sign8.signingUrl</name>
      <description>signing url of sign8 (e.g: https://dev-signing.sign8.eu/login)</description>
      <property>https://signing.sign8.eu/login</property>
    </customStringProperty>
    <customPasswordProperty>
      <name>sign8.secret</name>
      <description>secret for sign8</description>
      <property>d02f0d4614d40f3426cd7945871abdf155fa5f24</property>
    </customPasswordProperty>
    <customBooleanProperty>
      <name>mailbridgeService.saveInlineAttachments</name>
      <description>Save inline attachments as documents.</description>
      <property v="false" />
    </customBooleanProperty>
    <customStringProperty>
      <name>mailbridgeService.serverAddress</name>
      <description>Server address of the system starting with https: and ending with /client/ to be used in the mailbridge_servive process</description>
    </customStringProperty>
    <customStringProperty>
      <name>outlook.clientUrl</name>
      <description>url that is used for redirecting</description>
    </customStringProperty>
    <customStringProperty>
      <name>msGraph.client_id</name>
      <description>CLIENT_ID of a Azure Ressource that is used for MS Graph</description>
    </customStringProperty>
    <customStringProperty>
      <name>msGraph.client_secret</name>
      <description>CLIENT_SECRET of a Azure Ressource that is used for MS Graph</description>
    </customStringProperty>
    <customStringProperty>
      <name>msGraph.tenant</name>
      <description>TENANT of a Azure Ressource that is used for MS Graph</description>
    </customStringProperty>
    <customStringProperty>
      <name>this.URL</name>
      <description>the current url of the system</description>
    </customStringProperty>
    <customStringProperty>
      <name>emailNotification.sender</name>
      <description>the sender of the email notifications</description>
    </customStringProperty>
    <customStringProperty>
      <name>snapADDY.apiUrl</name>
      <description>The url to the mail signature webservice snapADDY.</description>
      <property>https://backend.snapaddy.com/repro/data-services/v2/email</property>
    </customStringProperty>
    <customStringProperty>
      <name>docx-templater.apiUrl</name>
      <description>The url to the docx-templater service</description>
      <property></property>
    </customStringProperty>
    <customPasswordProperty>
      <name>docx-templater.password</name>
      <description>The password for the basic auth of the docx-templater service</description>
      <property></property>
    </customPasswordProperty>
    <customStringProperty>
      <name>docx-templater.user</name>
      <description>The user for the basic auth of the docx-templater service</description>
      <property></property>
    </customStringProperty>
    <customStringProperty>
      <name>database.binarypath</name>
      <description>The path of saved binary files for the blobHandler</description>
      <property>/opt/ADITOData/binaryfiles/</property>
    </customStringProperty>
    <customStringProperty>
      <name>productimages.path</name>
      <description>image path for product images</description>
      <property>/opt/ADITO/binaryfiles/vendira-product-images/</property>
    </customStringProperty>
  </customConfigProperties>
  <customProperties>
    <customBooleanProperty>
      <name>phoneValidation.enable</name>
      <description></description>
      <property v="true" />
    </customBooleanProperty>
    <customBooleanProperty>
      <name>dsgvo.active</name>
      <property v="true" />
    </customBooleanProperty>
    <customBooleanProperty>
      <name>nominatim.enable</name>
      <property v="true" />
    </customBooleanProperty>
    <customStringProperty>
      <name>nominatim.url</name>
      <property>https://nom.adito.de/search.php</property>
    </customStringProperty>
    <customStringProperty>
      <name>nominatim.user</name>
      <property>aditouser</property>
    </customStringProperty>
    <customPasswordProperty>
      <name>nominatim.pw</name>
      <description></description>
      <property>useradito</property>
    </customPasswordProperty>
    <customIntegerProperty>
      <name>nominatim.resultLimit</name>
      <description>Amount of rows returned by the address search. Default is 10, maximum is 50.</description>
    </customIntegerProperty>
    <customJDitoProperty>
      <name>nominatim.filterKeys</name>
      <description></description>
    </customJDitoProperty>
    <customIntegerProperty>
      <name>duplicates.dataBlockSize</name>
      <property v="5000" />
    </customIntegerProperty>
    <customBooleanProperty>
      <name>AD.active</name>
      <description></description>
      <property v="true" />
    </customBooleanProperty>
    <customStringProperty>
      <name>AD.technicalUserDN</name>
      <description>Complete distinguishedName of the technical user</description>
    </customStringProperty>
    <customPasswordProperty>
      <name>AD.technicalUserPassword</name>
    </customPasswordProperty>
    <customStringProperty>
      <name>AD.URL</name>
      <description>URL to the Active Directory Server (withe ldap:// prefix and port), separate more values with semicolon  </description>
    </customStringProperty>
    <customStringProperty>
      <name>AD.Filter</name>
      <description>Filter in LDAP Filter Syntax</description>
    </customStringProperty>
    <customStringProperty>
      <name>AD.Config</name>
      <description>Start point of the search in tree, separate more values with semicolon </description>
    </customStringProperty>
    <customStringProperty>
      <name>supportticket.coderegex</name>
      <description>Regex for the Supportticketcode</description>
      <property>\[[0-9]{1,10}\]</property>
    </customStringProperty>
    <customStringProperty>
      <name>myCompany.addr</name>
      <description>Addressline of my company</description>
      <property>meineFirma | Wilhelm-Str. 2  |  DE 80807 München</property>
    </customStringProperty>
    <customStringProperty>
      <name>myCompany.logo</name>
      <description>Logo of my copany</description>
      <property>base64:</property>
    </customStringProperty>
    <customStringProperty>
      <name>myCompany.contactID</name>
      <description>The ID of the Company you are working for.</description>
      <property>b219b58a-f120-42d8-9a64-0b176501eac7</property>
    </customStringProperty>
    <customStringProperty>
      <name>myCompany.vatID</name>
      <description></description>
      <property>DE123456789</property>
    </customStringProperty>
    <customBooleanProperty>
      <name>observation.isEnabled</name>
      <description>Whether the observations are enabled or not</description>
      <property v="true" />
    </customBooleanProperty>
    <customBooleanProperty>
      <name>observation.isMultiselectionEnabled</name>
      <description>Whether the multiselectionaction for observations are enabled or not.</description>
      <property v="false" />
    </customBooleanProperty>
    <customStringProperty>
      <name>sales.vat</name>
      <description>Default VAT in percent</description>
      <property>19</property>
    </customStringProperty>
    <customBooleanProperty>
      <name>ai.salesprojectProbability</name>
      <description></description>
      <property v="false" />
    </customBooleanProperty>
    <customBooleanProperty>
      <name>ews.active</name>
      <description>Decides if EWS is activated or not</description>
      <property v="false" />
    </customBooleanProperty>
    <customIntegerProperty>
      <name>ews.syncsize</name>
      <description>Defines how big a filter for synchronizing to Outlook may be</description>
      <property v="7200" />
    </customIntegerProperty>
    <customStringProperty>
      <name>local.currency</name>
      <description>local currency as alpha3 (e.g. "EUR")</description>
      <property>EUR</property>
    </customStringProperty>
    <customBooleanProperty>
      <name>leadforensics.isActive</name>
      <description>Activates lead forensics interface</description>
    </customBooleanProperty>
    <customStringProperty>
      <name>leadforensics.clientID</name>
      <description>client Id of lead forensics</description>
    </customStringProperty>
    <customPasswordProperty>
      <name>leadforensics.authorizationToken</name>
      <description>authorization token for lead forensics</description>
    </customPasswordProperty>
    <customStringProperty>
      <name>leadforensics.startDate</name>
      <description>start date from which the first leadforensics import should start. subsequent imports will start from the date of the last import. format dd-MM-yyyy</description>
    </customStringProperty>
    <customBooleanProperty>
      <name>mail.importAttachments</name>
      <description>Controls whether attachments from imported emails are placed in the Documents tab of the associated activity.</description>
      <property v="true" />
    </customBooleanProperty>
    <customBooleanProperty>
      <name>address.hideStreetNumber</name>
      <description>Hide the street number from Address view and save it in the Streetaddress</description>
      <property v="true" />
    </customBooleanProperty>
    <customStringProperty>
      <name>defaultBusinessHoursTo</name>
      <description>Defualt business hours from as String</description>
      <property>17:00</property>
    </customStringProperty>
    <customStringProperty>
      <name>defaultBusinessHoursFrom</name>
      <description>Defualt business hours to as String</description>
      <property>08:00</property>
    </customStringProperty>
    <customBooleanProperty>
      <name>showAppointmentsInEPK</name>
      <description>Appointments should be displayed in the EPK</description>
      <property v="true" />
    </customBooleanProperty>
    <customIntegerProperty>
      <name>sales.businessYearStartingMonth</name>
      <description>Starting mont of the business year</description>
    </customIntegerProperty>
    <customStringProperty>
      <name>productimages.path</name>
      <description></description>
      <property>/opt/ADITO/binaryfiles/vendira-product-images/</property>
    </customStringProperty>
  </customProperties>
</preferences>
